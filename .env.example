APP_NAME=RootPilot
APP_ENV=development

PROMETHEUS_URL=
OPENSEARCH_URL=http://127.0.0.1:9200

# Active LLM provider
LLM_PROVIDER=gemini

# Agent configurations
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_EXECUTION_SECONDS=120

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude API (future)
ANTHROPIC_API_KEY=

# Claude via Vertex AI (future)
VERTEX_PROJECT_ID=
VERTEX_REGION=global
VERTEX_CLAUDE_MODEL=claude-haiku-4-5@20251001